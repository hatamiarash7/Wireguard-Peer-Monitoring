[app]
# Host to bind the UDP server
host = "0.0.0.0"
# Port to bind the UDP server
port = 9999
# Host to listen on for the Prometheus metrics endpoint.
metrics_host = "0.0.0.0"
# Port to listen on for the Prometheus metrics endpoint.
metrics_port = 9998

[wireguard]
# Wireguard interface name. This will be used to capture specific logs from kernel.
interface = "wg-server"

[redis]
# Redis configuration
db = 3
host = "localhost"
password = ""
port = 6379
username = "default"
# Maximum time for Redis connection and socket operations (seconds).
socket_timeout = 2.0

[manager]
# An empty URL disables webhooks. Delivery is best-effort and queued in memory.
# Wireguard manager webhook's URL
url = ""
timeout = 5.0
# Additional attempts after the first request; only transient errors are retried.
retries = 3
retry_delay = 0.5
queue_size = 1000
shutdown_timeout = 10.0
